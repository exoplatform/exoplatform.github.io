<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.exoplatform.documentation</groupId>
    <artifactId>openapi</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <artifactId>openapi-gatein_portal</artifactId>
  <packaging>jar</packaging>
  <name>Portal</name>
  <properties>
    <openapi.name>gatein_portal</openapi.name>
    <openapi.title>Portal REST API</openapi.title>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.meeds.portal</groupId>
      <artifactId>portal.component.portal</artifactId>
      <version>${platform.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>io.swagger.core.v3</groupId>
        <artifactId>swagger-maven-plugin</artifactId>
        <configuration>
          <!-- classes, not packages: their packages are shared with the other portal jars of the classpath,
               and swagger-core ignores resourcePackages once resourceClasses is set -->
          <resourceClasses>
            <class>org.exoplatform.portal.rest.UserRestResourcesV1</class>
            <class>org.exoplatform.portal.rest.GroupRestResourcesV1</class>
            <class>org.exoplatform.portal.rest.MembershipTypeRestResourcesV1</class>
            <class>org.exoplatform.portal.mop.rest.NavigationRest</class>
            <class>io.meeds.portal.security.rest.RegistrationSettingRest</class>
            <class>org.exoplatform.account.setup.rest.WelcomeScreenRestService</class>
            <class>org.exoplatform.portal.branding.BrandingRestResourcesV1</class>
          </resourceClasses>
        </configuration>
      </plugin>
      <!-- no Spring MVC controller in the services jar: JAX-RS only -->
    </plugins>
  </build>
</project>
