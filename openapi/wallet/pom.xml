<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.exoplatform.documentation</groupId>
    <artifactId>openapi</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <artifactId>openapi-wallet</artifactId>
  <packaging>jar</packaging>
  <name>Wallet</name>
  <properties>
    <openapi.name>wallet</openapi.name>
    <openapi.title>Wallet REST API</openapi.title>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.meeds.wallet</groupId>
      <artifactId>wallet-services</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <!-- the reward REST API is documented on the Wallet page too -->
    <dependency>
      <groupId>io.meeds.wallet</groupId>
      <artifactId>wallet-reward-services</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <!-- provided-scope dependencies of the services jar, needed to load its REST classes -->
    <dependency>
      <groupId>io.meeds.wallet</groupId>
      <artifactId>wallet-api</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <dependency>
      <groupId>io.meeds.commons</groupId>
      <artifactId>commons-comet-service</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <dependency>
      <groupId>io.meeds.social</groupId>
      <artifactId>social-component-notification</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <dependency>
      <groupId>io.meeds.analytics</groupId>
      <artifactId>analytics-api</artifactId>
      <version>${platform.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>io.swagger.core.v3</groupId>
        <artifactId>swagger-maven-plugin</artifactId>
        <configuration>
          <resourcePackages>
            <package>io.meeds.wallet.rest</package>
          </resourcePackages>
        </configuration>
      </plugin>
      <plugin>
        <!-- the reward API is Spring MVC, served by the wallet webapp -->
        <groupId>io.github.kbuntrock</groupId>
        <artifactId>openapi-maven-plugin</artifactId>
        <configuration>
          <apis>
            <api>
              <filename>wallet-spring.yaml</filename>
              <locations>
                <location>io.meeds.wallet.reward.rest</location>
              </locations>
            </api>
          </apis>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
