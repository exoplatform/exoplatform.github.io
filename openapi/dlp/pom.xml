<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.exoplatform.documentation</groupId>
    <artifactId>openapi</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <artifactId>openapi-dlp</artifactId>
  <packaging>jar</packaging>
  <name>Data Leak Prevention</name>
  <properties>
    <openapi.name>dlp</openapi.name>
    <openapi.title>Data Leak Prevention REST API</openapi.title>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.exoplatform.addons.dlp</groupId>
      <artifactId>dlp-services</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <!-- dependencies of the services jar that its published pom does not carry transitively (provided scope, or dlp-api), needed to load its REST classes -->
    <dependency>
      <groupId>org.exoplatform.addons.dlp</groupId>
      <artifactId>dlp-api</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <dependency>
      <groupId>org.exoplatform.ecms</groupId>
      <artifactId>ecms-core-services</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <dependency>
      <groupId>org.exoplatform.ecms</groupId>
      <artifactId>ecms-core-search</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <dependency>
      <groupId>io.meeds.social</groupId>
      <artifactId>social-component-notification</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <dependency>
      <groupId>io.meeds.social</groupId>
      <artifactId>social-component-service</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <dependency>
      <groupId>io.meeds.pwa</groupId>
      <artifactId>pwa-service</artifactId>
      <version>${platform.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>io.swagger.core.v3</groupId>
        <artifactId>swagger-maven-plugin</artifactId>
        <configuration>
          <resourcePackages>
            <package>org.exoplatform.dlp.rest</package>
          </resourcePackages>
        </configuration>
      </plugin>
      <!-- no Spring MVC controller in the services jar: JAX-RS only -->
    </plugins>
  </build>
</project>
