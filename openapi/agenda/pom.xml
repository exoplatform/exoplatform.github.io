<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.exoplatform.documentation</groupId>
    <artifactId>openapi</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <artifactId>openapi-agenda</artifactId>
  <packaging>jar</packaging>
  <name>Agenda</name>
  <properties>
    <openapi.name>agenda</openapi.name>
    <openapi.title>Agenda REST API</openapi.title>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.exoplatform.agenda</groupId>
      <artifactId>agenda-services</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <!-- provided-scope dependencies of the services jar, needed to load its REST classes -->
    <dependency>
      <groupId>org.exoplatform.agenda</groupId>
      <artifactId>agenda-api</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <dependency>
      <groupId>io.meeds.analytics</groupId>
      <artifactId>analytics-api</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <dependency>
      <groupId>io.meeds.social</groupId>
      <artifactId>social-component-service</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <dependency>
      <groupId>io.meeds.social</groupId>
      <artifactId>social-component-notification</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <dependency>
      <groupId>io.meeds.content</groupId>
      <artifactId>content-service</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <dependency>
      <groupId>io.meeds.commons</groupId>
      <artifactId>commons-component-common</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <dependency>
      <groupId>io.meeds.pwa</groupId>
      <artifactId>pwa-service</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <dependency>
      <groupId>io.meeds.mcp-server</groupId>
      <artifactId>mcp-server-tools</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <dependency>
      <groupId>io.meeds.app-center</groupId>
      <artifactId>app-center-services</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <dependency>
      <groupId>org.exoplatform.addons.email-connector</groupId>
      <artifactId>email-connector-services</artifactId>
      <version>${platform.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>io.swagger.core.v3</groupId>
        <artifactId>swagger-maven-plugin</artifactId>
        <configuration>
          <resourcePackages>
            <package>org.exoplatform.agenda.rest</package>
          </resourcePackages>
        </configuration>
      </plugin>
      <plugin>
        <groupId>io.github.kbuntrock</groupId>
        <artifactId>openapi-maven-plugin</artifactId>
        <configuration>
          <apis>
            <api>
              <filename>agenda-spring.yaml</filename>
              <locations>
                <location>org.exoplatform.agenda.rest</location>
              </locations>
            </api>
          </apis>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
