<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.exoplatform.documentation</groupId>
    <artifactId>openapi</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <artifactId>openapi-processes</artifactId>
  <packaging>jar</packaging>
  <name>Processes</name>
  <properties>
    <openapi.name>processes</openapi.name>
    <openapi.title>Processes REST API</openapi.title>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.exoplatform.processes</groupId>
      <artifactId>processes-services</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <!-- provided-scope dependencies of the services jar, needed to load its REST classes -->
    <dependency>
      <groupId>org.exoplatform.processes</groupId>
      <artifactId>processes-api</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <dependency>
      <groupId>io.meeds.social</groupId>
      <artifactId>social-component-service</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <dependency>
      <groupId>io.meeds.social</groupId>
      <artifactId>social-component-notification</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <dependency>
      <groupId>io.meeds.analytics</groupId>
      <artifactId>analytics-api</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <dependency>
      <groupId>io.meeds.task</groupId>
      <artifactId>task-management-services</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <dependency>
      <groupId>io.meeds.mcp-server</groupId>
      <artifactId>mcp-server-tools</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <dependency>
      <groupId>org.exoplatform.ecms</groupId>
      <artifactId>ecms-core-services</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <dependency>
      <groupId>io.meeds.pwa</groupId>
      <artifactId>pwa-service</artifactId>
      <version>${platform.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>io.swagger.core.v3</groupId>
        <artifactId>swagger-maven-plugin</artifactId>
        <configuration>
          <resourcePackages>
            <package>org.exoplatform.processes.rest</package>
          </resourcePackages>
        </configuration>
      </plugin>
      <!-- no Spring MVC controller in the services jar: JAX-RS only -->
    </plugins>
  </build>
</project>
