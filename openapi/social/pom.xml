<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.exoplatform.documentation</groupId>
    <artifactId>openapi</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <artifactId>openapi-social</artifactId>
  <packaging>jar</packaging>
  <name>Social</name>
  <properties>
    <openapi.name>social</openapi.name>
    <openapi.title>Social REST API</openapi.title>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.meeds.social</groupId>
      <artifactId>social-component-service</artifactId>
      <version>${platform.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>io.swagger.core.v3</groupId>
        <artifactId>swagger-maven-plugin</artifactId>
        <configuration>
          <resourcePackages>
            <package>org.exoplatform.social.rest.impl</package>
            <package>org.exoplatform.social.service.rest</package>
            <package>org.exoplatform.social.rest.suggest</package>
            <package>io.meeds.social.observer.rest</package>
            <package>io.meeds.social.rest.impl</package>
            <package>io.meeds.social.translation.rest</package>
          </resourcePackages>
        </configuration>
      </plugin>
      <plugin>
        <groupId>io.github.kbuntrock</groupId>
        <artifactId>openapi-maven-plugin</artifactId>
        <configuration>
          <apis>
            <api>
              <filename>social-spring.yaml</filename>
              <locations>
                <location>io.meeds.social</location>
              </locations>
            </api>
          </apis>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
